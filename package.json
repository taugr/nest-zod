{
  "name": "nest-zod",
  "type": "module",
  "version": "1.0.0",
  "description": "A library to provide helpers to validate and transform objects with Zod for NestJS.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "homepage": "https://github.com/taugr/nest-zod#readme",
  "bugs": {
    "url": "https://github.com/taugr/nest-zod/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/nest-zod.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "nestjs",
    "zod",
    "validation",
    "transformation",
    "openapi",
    "swagger"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./swagger": "./dist/swagger.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:playground": "pnpm run build && pnpm --filter nest-zod-playground run build",
    "dev": "tsdown --watch",
    "playground:dev": "pnpm run build && pnpm --parallel --filter nest-zod --filter nest-zod-playground run dev",
    "playground:start": "pnpm run build && pnpm --filter nest-zod-playground run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "prepare": "husky",
    "quality": "pnpm run --parallel \"/^(lint|test:coverage)$/\"",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.1.28",
    "@shikijs/vitepress-twoslash": "^4.3.1",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "7.0.0-dev.20260702.3",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^11.1.0",
    "floating-vue": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.13",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-llms": "^1.13.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  }
}
