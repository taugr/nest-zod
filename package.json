{
  "name": "nest-zod",
  "type": "module",
  "version": "2.1.0",
  "description": "A library to provide helpers to validate and transform objects with Zod for NestJS.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "homepage": "https://nestzod.dev",
  "bugs": {
    "url": "https://github.com/taugr/nest-zod/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/nest-zod.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "nestjs",
    "zod",
    "validation",
    "transformation",
    "openapi",
    "swagger"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./swagger": "./dist/swagger.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:playground": "pnpm run build && pnpm --filter nest-zod-playground run build",
    "dev": "tsdown --watch",
    "playground:dev": "pnpm run build && pnpm --parallel --filter nest-zod --filter nest-zod-playground run dev",
    "playground:start": "pnpm run build && pnpm --filter nest-zod-playground run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/check-packed-consumer.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "prepare": "husky",
    "quality": "pnpm run --parallel \"/^(lint|test:coverage)$/\"",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.1.28",
    "@shikijs/vitepress-twoslash": "^4.4.1",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^12.1.1",
    "floating-vue": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.13.4",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^8.0.0 || ^11.0.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  }
}
