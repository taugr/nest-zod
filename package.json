{
  "name": "nest-zod",
  "type": "module",
  "version": "2.1.0",
  "description": "A library to provide helpers to validate and transform objects with Zod for NestJS.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "homepage": "https://nestzod.dev",
  "bugs": {
    "url": "https://github.com/taugr/nest-zod/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/nest-zod.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "nestjs",
    "zod",
    "validation",
    "transformation",
    "openapi",
    "swagger"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./swagger": "./dist/swagger.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:playground": "pnpm run build && pnpm --filter nest-zod-playground run build",
    "dev": "tsdown --watch",
    "playground:dev": "pnpm run build && pnpm --parallel --filter nest-zod --filter nest-zod-playground run dev",
    "playground:start": "pnpm run build && pnpm --filter nest-zod-playground run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/check-packed-consumer.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "prepare": "husky",
    "quality": "pnpm -w run --parallel \"/^(lint|test:coverage)$/\"",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.2",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "floating-vue": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^8.0.0 || ^11.0.0 || ^12.0.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  }
}
